
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-v2"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         String
  isActive     Boolean  @default(true)
  isApproved   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student  Student?
  guardian Guardian?
  teacher  Teacher?
  auditLogs AuditLog[]
}

model Student {
  id          String    @id @default(cuid())
  admissionNo String    @unique
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  gender      String?
  userId      String?   @unique
  classId     String?
  sectionId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User?             @relation(fields: [userId], references: [id])
  schoolClass SchoolClass?      @relation(fields: [classId], references: [id])
  section     Section?          @relation(fields: [sectionId], references: [id])
  guardians   StudentGuardian[]
  attendance  Attendance[]
  examResults ExamResult[]
  feeInvoices FeeInvoice[]
}

model Guardian {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  createdAt DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id])
  students StudentGuardian[]
}

model StudentGuardian {
  studentId  String
  guardianId String
  relation   String?

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
}

model Teacher {
  id         String   @id @default(cuid())
  userId     String   @unique
  employeeNo String   @unique
  phone      String?
  createdAt  DateTime @default(now())

  user             User          @relation(fields: [userId], references: [id])
  classAssignments TeacherClass[]
  attendance       Attendance[]
  subjects         ClassSubject[]
}

model SchoolClass {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  sections         Section[]
  students         Student[]
  teacherAssignments TeacherClass[]
  subjectAssignments ClassSubject[]
  exams             Exam[]
}

model Section {
  id        String   @id @default(cuid())
  name      String
  classId   String
  createdAt DateTime @default(now())

  schoolClass       SchoolClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  students          Student[]
  teacherAssignments TeacherClass[]
  subjectAssignments ClassSubject[]
  exams              Exam[]

  @@unique([name, classId])
}

model TeacherClass {
  id        String @id @default(cuid())
  teacherId String
  classId   String
  sectionId String
  createdAt DateTime @default(now())

  teacher     Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  section     Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([teacherId, sectionId])
  @@index([classId, sectionId])
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime
  session   String   @default("MORNING")
  status    String
  teacherId String?
  createdAt DateTime @default(now())

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id])

  @@unique([studentId, date, session])
  @@index([date, session])
}

model Subject {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  classAssignments ClassSubject[]
  examResults      ExamResult[]
  exams            Exam[]
}

model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  sectionId String?
  subjectId String
  teacherId String?
  createdAt DateTime @default(now())

  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  section     Section?    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     Teacher?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([classId, sectionId, subjectId])
  @@index([teacherId, classId, sectionId])
}

model Exam {
  id             String   @id @default(cuid())
  title          String
  classId        String
  sectionId      String?
  subjectId      String
  examDate       DateTime
  maxMarks       Int
  passMarks      Int
  gradeRules     String   @default("[{\"grade\":\"A\",\"minPercent\":90},{\"grade\":\"B\",\"minPercent\":80},{\"grade\":\"C\",\"minPercent\":70},{\"grade\":\"D\",\"minPercent\":60},{\"grade\":\"E\",\"minPercent\":50},{\"grade\":\"F\",\"minPercent\":0}]")
  createdAt      DateTime @default(now())

  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  section     Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  results     ExamResult[]

  @@index([classId, sectionId, examDate])
}

model ExamResult {
  id        String   @id @default(cuid())
  examId    String
  studentId String
  subjectId String
  marks     Int
  grade     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([examId, studentId])
  @@index([studentId, examId])
}

model FeeInvoice {
  id          String   @id @default(cuid())
  invoiceNo   String   @unique
  studentId   String
  description String
  amountCents Int
  paidCents   Int      @default(0)
  dueDate     DateTime
  createdAt   DateTime @default(now())

  student  Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments FeePayment[]

  @@index([studentId, dueDate])
}

model FeePayment {
  id             String   @id @default(cuid())
  invoiceId      String
  idempotencyKey String   @unique
  amountCents    Int
  method         String   @default("SIMULATED")
  createdAt      DateTime @default(now())

  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entity     String
  entityId   String
  details    String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
}
